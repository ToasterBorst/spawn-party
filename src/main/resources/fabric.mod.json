{
	"schemaVersion": 1,
	"id": "spawnparty",
	"version": "${version}",
	"name": "Spawn Party",
	"description": "Party-based multiplayer spawns with shared origins, light social tools, and server-side chest menus. Clients do not need the mod.",
	"authors": [
		"ToasterBorst"
	],
	"contributors": [
	],
	"icon": "assets/spawnparty/icon.png",
	"contact": {
		"homepage": "https://github.com/ToasterBorst/spawn-party",
		"sources": "https://github.com/ToasterBorst/spawn-party",
		"issues": "https://github.com/ToasterBorst/spawn-party/issues"
	},
	"license": "CC0-1.0",
	"environment": "*",
	"entrypoints": {
		"main": [
			"spawnparty.SpawnPartyMod"
		]
	},
	"mixins": [
		"spawnparty.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=26.2",
		"java": ">=25",
		"fabric-api": ">=0.153.0"
	}
}
